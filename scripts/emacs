#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" == Darwin ]]; then
	for app in /Applications/Emacs.app "$HOME/Applications/Emacs.app"; do
		if [[ -x "$app/Contents/MacOS/Emacs" ]]; then
			exec "$app/Contents/MacOS/Emacs" "$@"
		fi
	done
	echo "emacs: Emacs.app not found in /Applications or ~/Applications" >&2
	exit 1
fi

while IFS= read -r bin; do
	[[ "$bin" -ef "${BASH_SOURCE[0]}" ]] && continue
	exec "$bin" "$@"
done < <(type -ap emacs)

echo "emacs: no emacs found in PATH" >&2
exit 1
