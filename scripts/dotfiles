#!/bin/bash

# Make script strict
# e: exit on error
# u: error on undefined variables
# o pipefail: failed command in | counts as failure
set -euo pipefail

# === FLAGS ===
DRY_RUN=false
INSTALL_YAY=false

for arg in "$@"; do
	case $arg in
		-d|--dry-run)	DRY_RUN=true ;;
		--yay)			INSTALL_YAY=true ;;
		*)				echo "Unknown argument: $arg"; exit 1 ;;
	esac
done

# === PATHS ===
SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
PACMAN_LIST="$REPO_DIR/packages/pacman.txt"
AUR_LIST="$REPO_DIR/packages/aur.txt"
BREW_LIST="$REPO_DIR/packages/brew.txt"
BREW_CASK_LIST="$REPO_DIR/packages/brew-casks.txt"

# === LOAD HELPERS ===
source "$SCRIPT_DIR/lib/methods.sh"
source "$SCRIPT_DIR/lib/platform.sh"

PLATFORM="$(detect_platform)"

if $INSTALL_YAY && [[ "$PLATFORM" != arch ]]; then
	echo "[error] --yay is only supported on Arch Linux and its derivatives" >&2
	exit 1
fi

setup_symlinks () {
	if $DRY_RUN; then 
		"$SCRIPT_DIR/setup_symlinks" -d
		return
	fi

	"$SCRIPT_DIR/setup_symlinks"
}


# === MAIN ===
case "$PLATFORM" in
	arch)
		if $INSTALL_YAY; then
			install_yay
		fi
		install_pacman
		install_aur
		;;
	macos)
		install_brew
		;;
	*)
		log "Unsupported OS or distribution; skipping package installation"
		;;
esac

setup_symlinks
