# Window 1 already exists — launch neovim in it
tmux send-keys -t "$1:1" "nvim ." Enter

# Create window 2 and leave it as a plain shell
tmux new-window -t "$1:2"

# Create window 3 and launch copilot in it
tmux new-window -t "$1:3"
tmux send-keys -t "$1:3" "copilot" Enter

# Focus back on window 1
tmux select-window -t "$1:1"
