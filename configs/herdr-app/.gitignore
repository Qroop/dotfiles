# Keep personal configuration and custom layouts, mods and themes.
/*
!/.gitignore
!/README.md
!/keys.json
!/settings.json
!/programs.json
!/layouts/
!/mods/
!/themes/

# Herdr-managed layout state and shipped layouts.
/layouts/.state/
/layouts/main.json
/layouts/terminals.json
/layouts/win98.json
/layouts/win98.svg

# Shipped mods and generated editor support files.
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/
/mods/*/*.d.ts
/mods/*/jsconfig.json

# Shipped themes.
/themes/atom-one-dark.json
/themes/win98.json
