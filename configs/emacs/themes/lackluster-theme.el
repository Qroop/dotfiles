;;; lackluster-theme.el --- lackluster-mint for Emacs -*- lexical-binding: t; -*-

(deftheme lackluster "Port of lackluster.nvim (mint variant).")

(let ((bg "#030303") (fg "#cccccc")
      (g2 "#191919") (g3 "#2a2a2a") (g4 "#444444") (g5 "#555555")
      (g6 "#7a7a7a") (g7 "#aaaaaa")
      (lack "#708090") (luster "#deeeed") (green "#789978") (blue "#7788aa")
      (orange "#ffaa88") (red "#d70000")
      (comment "#6f9f60") (keyword "#666666") (cursorline "#202020")
      (popup "#1a1a1a") (statusline "#242424"))
  (custom-theme-set-faces
   'lackluster
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,fg))))
   `(region ((t (:background ,fg :foreground "#000000" :extend t))))
   `(secondary-selection ((t (:background ,g3))))
   `(highlight ((t (:background ,g3))))
   `(hl-line ((t (:background ,cursorline :extend t))))
   `(fringe ((t (:background ,bg :foreground ,g4))))
   `(vertical-border ((t (:foreground ,g4))))
   `(window-divider ((t (:foreground ,g4))))
   `(shadow ((t (:foreground ,g5))))
   `(link ((t (:foreground ,lack :underline t))))
   `(link-visited ((t (:foreground ,g6 :underline t))))
   `(button ((t (:foreground ,lack :underline t))))
   `(minibuffer-prompt ((t (:foreground ,g7))))
   `(error ((t (:foreground ,red))))
   `(warning ((t (:foreground ,orange))))
   `(success ((t (:foreground ,green))))
   `(escape-glyph ((t (:foreground ,green))))
   `(trailing-whitespace ((t (:background ,g3))))
   `(match ((t (:background ,lack :foreground "#000000"))))
   `(isearch ((t (:background ,lack :foreground "#000000"))))
   `(isearch-fail ((t (:foreground ,red))))
   `(lazy-highlight ((t (:background ,g3 :foreground ,fg))))
   `(show-paren-match ((t (:background ,lack :foreground ,fg))))
   `(show-paren-mismatch ((t (:background ,red :foreground ,fg))))
   `(line-number ((t (:inherit default :foreground ,g4))))
   `(line-number-current-line ((t (:inherit default :foreground ,g7 :background ,cursorline))))
   `(mode-line ((t (:background ,statusline :foreground ,g7 :box nil))))
   `(mode-line-inactive ((t (:background "#080808" :foreground ,g4 :box nil))))
   `(mode-line-emphasis ((t (:foreground ,fg))))
   `(mode-line-highlight ((t (:foreground ,fg))))
   `(header-line ((t (:background ,statusline :foreground ,g7))))
   `(tooltip ((t (:background ,popup :foreground ,g6))))
   `(menu ((t (:background ,g2 :foreground ,g6))))
   `(tab-bar ((t (:background ,g2 :foreground ,g4))))
   `(tab-bar-tab ((t (:background ,fg :foreground "#080808"))))
   `(tab-bar-tab-inactive ((t (:background ,g2 :foreground ,g4))))
   `(font-lock-comment-face ((t (:foreground ,comment))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,comment))))
   `(font-lock-doc-face ((t (:foreground ,lack))))
   `(font-lock-string-face ((t (:foreground ,lack))))
   `(font-lock-escape-face ((t (:foreground ,green))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,green))))
   `(font-lock-regexp-grouping-construct ((t (:foreground ,green))))
   `(font-lock-keyword-face ((t (:foreground ,keyword))))
   `(font-lock-builtin-face ((t (:foreground ,g5))))
   `(font-lock-function-name-face ((t (:foreground ,luster))))
   `(font-lock-function-call-face ((t (:foreground ,g6))))
   `(font-lock-variable-name-face ((t (:foreground ,fg))))
   `(font-lock-variable-use-face ((t (:foreground ,fg))))
   `(font-lock-property-name-face ((t (:foreground ,g7))))
   `(font-lock-property-use-face ((t (:foreground ,g7))))
   `(font-lock-type-face ((t (:foreground ,green))))
   `(font-lock-constant-face ((t (:foreground ,g7))))
   `(font-lock-number-face ((t (:foreground ,g7))))
   `(font-lock-preprocessor-face ((t (:foreground ,g5))))
   `(font-lock-negation-char-face ((t (:foreground ,g6))))
   `(font-lock-punctuation-face ((t (:foreground ,g6))))
   `(font-lock-bracket-face ((t (:foreground ,g6))))
   `(font-lock-delimiter-face ((t (:foreground ,g6))))
   `(font-lock-operator-face ((t (:foreground ,g6))))
   `(font-lock-warning-face ((t (:foreground ,orange))))
   `(diff-added ((t (:foreground ,green))))
   `(diff-removed ((t (:foreground ,orange))))
   `(diff-changed ((t (:foreground ,g6))))
   `(diff-hl-insert ((t (:background ,green :foreground ,green))))
   `(diff-hl-change ((t (:background ,g6 :foreground ,g6))))
   `(diff-hl-delete ((t (:background ,orange :foreground ,orange))))
   `(dired-directory ((t (:foreground ,blue))))
   `(compilation-error((t (:foreground ,red))))
   `(compilation-warning ((t (:foreground ,orange))))
   `(compilation-info ((t (:foreground ,luster))))))

(provide-theme 'lackluster)
