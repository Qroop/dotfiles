. ~/.aliases
. ~/.variables
. ~/.git-prompt.sh

autoload -Uz compinit
compinit

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

fcd() {
	local dir
	dir=$(find ~ -maxdepth 5 -type d -not -path '*/.*' 2>/dev/null | fzf "${FZF_DIR_PREVIEW_OPTS[@]}") && cd "$dir"
}
fcdh() {
	local dir
	dir=$(find ~ -maxdepth 5 -type d 2>/dev/null | fzf "${FZF_DIR_PREVIEW_OPTS[@]}") && cd "$dir"
}
ftmux() {
	if ! tmux info >/dev/null 2>&1; then
		tmux new-session < /dev/tty
		return
	fi
	local session
	session=$(tmux list-sessions | cut -d: -f1 | fzf) && tmux attach -t "$session" < /dev/tty
}

fzf-fcd-widget() {
	fcd
	zle reset-prompt
}
zle -N fzf-fcd-widget

fzf-fcdh-widget() {
	fcdh
	zle reset-prompt
}
zle -N fzf-fcdh-widget

# bindkey '^A' fzf-tmux-sessionizer-widget
bindkey -s ^a "tmux-sessionizer\n"
bindkey '^E' fzf-fcd-widget
bindkey '^V' fzf-fcdh-widget

setopt PROMPT_SUBST
PS1='%B%F{cyan}%~%b%f%F{#f34f29}$(__git_ps1 " [⎇ %s]")%f $ '
